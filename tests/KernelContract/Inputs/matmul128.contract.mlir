// Design reference, not generated by an implemented contract frontend.
// Neutral integer canonicalization has folded dot(A,B,0)+previous into outs(C).
// M=128, N=1024, K=128; tile [64,64,128], grid [2,16,1] = 32 programs.
// All three source loads retain private snapshots. Only the planner may
// forward them to external views after proving that all reads/writes agree.
// Source events/tasks: A load=0, B load=1, C load=2, dot=3, C store=4.
module attributes {
  contract.version = 1 : i32,
  contract.producer = "neutral-design-reference",
  contract.abi = {args_aligned_bytes = 64 : i64, args_disjoint = true}
} {
  func.func @matmul128(
      %a: memref<*xi8> {contract.value_id = 0 : i64},
      %b: memref<*xi8> {contract.value_id = 1 : i64},
      %c: memref<*xi32> {contract.value_id = 2 : i64},
      %pid_m: index {contract.program = {role = "program_id", axis = 0 : i32}},
      %pid_n: index {contract.program = {role = "program_id", axis = 1 : i32}})
      attributes {
        contract.grid = array<i32: 2, 16, 1>,
        contract.compute_graph = {version = 1 : i32, root_scope = 0 : i64,
          complete = true, scope_count = 1 : i64, source_lineage_complete = true}
      } {
    %c64 = arith.constant 64 : index
    %c128 = arith.constant 128 : index
    %c1024 = arith.constant 1024 : index
    %row = arith.muli %pid_m, %c64 : index
    %col = arith.muli %pid_n, %c64 : index
    %a_off = arith.muli %row, %c128 : index
    %b_off = arith.muli %col, %c128 : index
    %c_row = arith.muli %row, %c1024 : index
    %c_off = arith.addi %c_row, %col : index
    %av = memref.reinterpret_cast %a to offset: [%a_off], sizes: [64, 128], strides: [128, 1]
      : memref<*xi8> to memref<64x128xi8, strided<[128, 1], offset: ?>>
    %bv = memref.reinterpret_cast %b to offset: [%b_off], sizes: [128, 64], strides: [1, 128]
      : memref<*xi8> to memref<128x64xi8, strided<[1, 128], offset: ?>>
    %cv = memref.reinterpret_cast %c to offset: [%c_off], sizes: [64, 64], strides: [1024, 1]
      : memref<*xi32> to memref<64x64xi32, strided<[1024, 1], offset: ?>>
    %a_snapshot = memref.alloc() alignment = 64
      {contract.buffer = {role = "tile", kind = "input-a", logical_shape = array<i64: 64, 128>}}
      : memref<64x128xi8>
    memref.copy %av, %a_snapshot
      {contract.task = {id = 0 : i64, kind = "memory-load", scope = 0 : i64,
          stage = 0 : i64, predecessors = array<i64>, input_values = array<i64: 0>,
          output_values = array<i64: 3>, barrier_after = true, rematerializable = false,
          origin_id = 0 : i64},
       contract.access = {kind = "load", boundary = "external_ddr", origin_id = 0 : i64,
          mask = {kind = "none"}},
       contract.provenance = {source_load_origin_ids = array<i64: 0>}}
      : memref<64x128xi8, strided<[128, 1], offset: ?>> to memref<64x128xi8>
    // Compact physical [N,K] backing storage preserves B's contiguous K axis.
    // This is a logical snapshot layout, without a bank or hardware tile choice.
    %b_storage = memref.alloc() alignment = 64
      {contract.buffer = {role = "tile", kind = "input-b", logical_shape = array<i64: 128, 64>}}
      : memref<8192xi8>
    %b_snapshot = memref.reinterpret_cast %b_storage to offset: [0], sizes: [128, 64], strides: [1, 128]
      : memref<8192xi8> to memref<128x64xi8, strided<[1, 128]>>
    memref.copy %bv, %b_snapshot
      {contract.task = {id = 1 : i64, kind = "memory-load", scope = 0 : i64,
          stage = 0 : i64, predecessors = array<i64>, input_values = array<i64: 1>,
          output_values = array<i64: 4>, barrier_after = true, rematerializable = false,
          origin_id = 1 : i64},
       contract.access = {kind = "load", boundary = "external_ddr", origin_id = 1 : i64,
          mask = {kind = "none"}},
       contract.provenance = {source_load_origin_ids = array<i64: 1>}}
      : memref<128x64xi8, strided<[1, 128], offset: ?>> to memref<128x64xi8, strided<[1, 128]>>
    %snapshot = memref.alloc() alignment = 64
      {contract.buffer = {role = "tile", kind = "accumulator", logical_shape = array<i64: 64, 64>}}
      : memref<64x64xi32>
    memref.copy %cv, %snapshot
      {contract.task = {id = 2 : i64, kind = "memory-load", scope = 0 : i64,
          stage = 0 : i64, predecessors = array<i64>, input_values = array<i64: 2>,
          output_values = array<i64: 5>, barrier_after = true, rematerializable = false,
          origin_id = 2 : i64},
       contract.access = {kind = "load", boundary = "external_ddr", origin_id = 2 : i64,
          mask = {kind = "none"}},
       contract.provenance = {source_load_origin_ids = array<i64: 2>}}
      : memref<64x64xi32, strided<[1024, 1], offset: ?>> to memref<64x64xi32>
    linalg.matmul {cast = #linalg.type_fn<cast_signed>,
      contract.task = {id = 3 : i64, kind = "dot", scope = 0 : i64, stage = 1 : i64,
        predecessors = array<i64: 0, 1, 2>, input_values = array<i64: 3, 4, 5>,
        output_values = array<i64: 6>, barrier_after = true, rematerializable = false,
        origin_id = 3 : i64},
      contract.compute = {kind = "dot", signed = true, lhs = "i8", rhs = "i8", acc = "i32"},
      contract.provenance = {origin_id = 3 : i64, source_load_origin_ids = array<i64: 0, 1, 2>,
        a_origin_id = 0 : i64, b_origin_id = 1 : i64, accumulator_origin_id = 2 : i64,
        a_source_load_origin_ids = array<i64: 0>, b_source_load_origin_ids = array<i64: 1>,
        accumulator_source_load_origin_ids = array<i64: 2>,
        a_source_lineage_complete = true, b_source_lineage_complete = true,
        accumulator_source_lineage_complete = true}}
      ins(%a_snapshot, %b_snapshot : memref<64x128xi8>, memref<128x64xi8, strided<[1, 128]>>)
      outs(%snapshot : memref<64x64xi32>)
    memref.copy %snapshot, %cv
      {contract.task = {id = 4 : i64, kind = "memory-store", scope = 0 : i64,
          stage = 2 : i64, predecessors = array<i64: 2, 3>, input_values = array<i64: 6>,
          output_values = array<i64>, barrier_after = true, rematerializable = false,
          origin_id = 4 : i64},
       contract.access = {kind = "store", boundary = "external_ddr", origin_id = 4 : i64,
          mask = {kind = "none"}},
       contract.provenance = {source_load_origin_ids = array<i64: 0, 1, 2>}}
      : memref<64x64xi32> to memref<64x64xi32, strided<[1024, 1], offset: ?>>
    memref.dealloc %a_snapshot : memref<64x128xi8>
    memref.dealloc %b_storage : memref<8192xi8>
    memref.dealloc %snapshot : memref<64x64xi32>
    return
  }
}
