/* Generated by cases.py. Independent FP64 m/n/k oracle for physical W[N,K]. */
#include "support.h"
#ifdef HOST_TEST
#include <stdio.h>
#endif
#define M @M@
#define N @N@
#define K @K@
#define TRIALS 8
#ifndef HOST_TEST
static float x_storage[M * K + 2 * GUARD_FLOATS] WORKSPACE;
static float weight_storage[N * K + 2 * GUARD_FLOATS] WORKSPACE;
static float bias_storage[N + 2 * GUARD_FLOATS] WORKSPACE;
static float out_storage[M * N + 2 * GUARD_FLOATS] WORKSPACE;
#else
#define x_storage NULL
#define weight_storage NULL
#define bias_storage NULL
#define out_storage NULL
#endif
extern void run_linear(float *, float *, float *, float *);

static uint32_t float_bits(float value) {
  union { float f; uint32_t u; } bits = {value};
  return bits.u;
}

static float x_value(int m, int k, int trial) {
  if (trial == 0) return k % 2 ? -0.0f : 0.0f;
  if (trial == 1) return k == 0 ? 1.0f : 0.0f;
  if (trial == 2) return k == K - 1 ? -2.0f : 0.0f;
  if (trial == 3) return k == K / 2 ? 0.5f : 0.0f;
  if (trial == 6) return k % 2 ? -1.0f : 1.0f;
  return (float)((m * 13 + k * 37 + trial * 11) % 127 - 63) * 0.013f;
}

static float weight_value(int n, int k, int trial) {
  if (trial == 7 && n != N - 1) return 0.0f;
  if (trial == 6) return 4.0f + (float)((n * 7 + k) % 23) * 0.0001f;
  return (float)((n * 31 + k * 17 + trial * 19) % 257 - 128) * 0.007f
         + (float)(n % 11) * 0.0003f;
}

static float bias_value(int n, int trial) {
  if (trial == 7) return n == N - 1 ? -0.25f : 0.0f;
  return (float)((n * 13 + trial * 3) % 101 - 50) * 0.019f;
}

int launch(void) {
  GuardedBuffer buffers[4] = {{0}};
  const size_t sizes[4] = {M * K, N * K, N, M * N};
  float *storage[4] = {x_storage, weight_storage, bias_storage, out_storage};
  for (int i = 0; i < 4; ++i) {
    if (buffer_init(&buffers[i], sizes[i], storage[i])) {
      for (int j = 0; j < i; ++j) buffer_free(&buffers[j]);
      return report_check("@CASE@", 1, 0);
    }
  }
  float *x = buffers[0].data, *weight = buffers[1].data;
  float *bias = buffers[2].data, *out = buffers[3].data;
  unsigned errors = 0;
  double maximum = 0, maximum_ratio = 0, maximum_bound = 0;
  const double ku = (K + 2) * 0x1p-24;
  const double gamma = ku / (1.0 - ku);
  for (int trial = 0; trial < TRIALS; ++trial) {
    for (int m = 0; m < M; ++m)
      for (int k = 0; k < K; ++k) x[m * K + k] = x_value(m, k, trial);
    for (int n = 0; n < N; ++n) {
      bias[n] = bias_value(n, trial);
      for (int k = 0; k < K; ++k) weight[n * K + k] = weight_value(n, k, trial);
    }
    for (int i = 0; i < M * N; ++i) out[i] = -9999.0f;
    run_linear(x, weight, bias, out);
    /* No Triton output participates in reference computation. Each FP32
     * product is exact in double; accumulation and bias are evaluated in FP64.
     * No reference transpose, BLAS call or packed weights. */
    for (int m = 0; m < M; ++m)
      for (int n = 0; n < N; ++n) {
        double sum = 0, magnitude = 0;
        for (int k = 0; k < K; ++k) {
          double product = (double)x[m * K + k] * (double)weight[n * K + k];
          sum += product;
          magnitude += product < 0 ? -product : product;
        }
        sum += (double)bias[n];
        magnitude += bias[n] < 0 ? -(double)bias[n] : (double)bias[n];
        double bound = gamma * magnitude + (K + 2) * 0x1p-149;
        if (bound > maximum_bound) maximum_bound = bound;
        float actual = out[m * N + n];
        if (!__builtin_isfinite(actual)) {
          ++errors; maximum = __builtin_inf(); maximum_ratio = __builtin_inf();
        } else {
          double difference = (double)actual - sum;
          if (difference < 0) difference = -difference;
          errors += difference > bound;
          if (difference > maximum) maximum = difference;
          double ratio = difference / bound;
          if (ratio > maximum_ratio) maximum_ratio = ratio;
        }
      }
    for (int m = 0; m < M; ++m)
      for (int k = 0; k < K; ++k)
        errors += float_bits(x[m * K + k]) != float_bits(x_value(m, k, trial));
    for (int n = 0; n < N; ++n) {
      errors += float_bits(bias[n]) != float_bits(bias_value(n, trial));
      for (int k = 0; k < K; ++k)
        errors += float_bits(weight[n * K + k]) != float_bits(weight_value(n, k, trial));
    }
    for (int i = 0; i < 4; ++i) errors += buffer_check(&buffers[i]);
  }
  for (int i = 0; i < 4; ++i) buffer_free(&buffers[i]);
#ifdef HOST_TEST
  printf("linear metrics max_abs_error=%.17g max_error_over_bound=%.17g max_bound=%.17g\n",
         maximum, maximum_ratio, maximum_bound);
#endif
  return report_check("@CASE@", errors, (float)maximum);
}

#ifdef HOST_TEST
int main(void) { return launch(); }
#endif
