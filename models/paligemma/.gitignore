# PaliGemma-generated artifacts and staged HF snapshot files.
# `buddy_add_model` re-imports / re-stages these from the local HF snapshot
# (BUDDY_PALIGEMMA_MODEL_PATH) at build time, so nothing here is committed.

# Import output
arg0.data
layer_partitioned/

# Python caches
__pycache__/

# HuggingFace snapshot files (staged via ASSET_FILES / PALIGEMMA_MODEL_PATH)
config.json
tokenizer.json
tokenizer_config.json
tokenizer.model
special_tokens_map.json
added_tokens.json
generation_config.json
preprocessor_config.json
artifact.metadata
model.safetensors
model.safetensors.index.json
pytorch_model.bin

# Root-level compiled IR (build/ contains the real generated outputs)
forward.mlir
subgraph0.mlir
