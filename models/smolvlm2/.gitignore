# SmolVLM2-generated artifacts and staged HF snapshot files.
# `buddy_add_model` re-imports / re-stages these from the local HF snapshot
# (BUDDY_SMOLVLM2_MODEL_PATH) at build time, so nothing here is committed.

# Stale artifacts from the original integration (pre-rework), left in place
# but never committed.
arg0.data
layer_partitioned/

# Import output
forward.mlir
subgraph0.mlir

# Python caches
__pycache__/

# HuggingFace snapshot files (staged via ASSET_FILES / SMOLVLM2_MODEL_PATH)
config.json
tokenizer.json
tokenizer_config.json
vocab.json
merges.txt
added_tokens.json
special_tokens_map.json
artifact.metadata
model.safetensors
pytorch_model.bin
